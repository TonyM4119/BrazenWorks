// SPDX-License-Identifier: MIT
// Fork: the Windows resources of the program file, generated from
// branding.json by cmake/Branding.cmake: the icon (Explorer, the taskbar,
// shortcuts) and the version information (the file's Properties, Task
// Manager). The window's own icon is set in main.cpp.
#include <winver.h>

IDI_ICON1 ICON "@BRAND_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION @BRAND_VERSION_MAJOR@,@BRAND_VERSION_MINOR@,@BRAND_VERSION_PATCH@,0
  PRODUCTVERSION @BRAND_VERSION_MAJOR@,@BRAND_VERSION_MINOR@,@BRAND_VERSION_PATCH@,0
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
  FILEFLAGS 0
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "@BRAND_DISPLAY_NAME@\0"
      VALUE "FileDescription", "@BRAND_DISPLAY_NAME@\0"
      VALUE "FileVersion", "@BRAND_VERSION@\0"
      VALUE "InternalName", "@BRAND_SLUG@\0"
      VALUE "LegalCopyright", "MIT licence. Based on @BRAND_UPSTREAM_NAME@ @PROJECT_VERSION@ (@BRAND_UPSTREAM_URL@)\0"
      VALUE "OriginalFilename", "@BRAND_EXE@\0"
      VALUE "ProductName", "@BRAND_DISPLAY_NAME@\0"
      VALUE "ProductVersion", "@BRAND_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
